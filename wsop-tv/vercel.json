{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/v2", "destination": "/v2/", "permanent": false },
    { "source": "/v3", "destination": "/v3/", "permanent": false },
    { "source": "/:path((?!v2/|v2$|v3/|v3$).*)", "destination": "/v2/", "permanent": false }
  ]
}
